# Qualquer .env fica de fora, não só os sufixos conhecidos: o arquivo de
# produção mora dentro do repo clonado no droplet, e um `git add -A` distraído
# publicaria token do túnel, APP_KEY e senha do banco.
.env
.env.*
!.env.example

apps/api/storage/*.key
apps/api/storage/logs/*
apps/api/storage/framework/cache/*
apps/api/storage/framework/sessions/*
apps/api/storage/framework/views/*
apps/api/bootstrap/cache/*

.DS_Store
*.log
.idea/
.vscode/
