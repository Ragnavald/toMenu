# Imagem de produção da API: PHP-FPM, não o servidor embutido do artisan.
#
# O Dockerfile de desenvolvimento usa `php artisan serve`, que é single-threaded
# e explicitamente não recomendado para produção — uma requisição lenta bloqueia
# todas as outras. Aqui o código é copiado para dentro da imagem (não montado
# por volume), para que o container seja imutável e reproduzível.
FROM php:8.3-fpm AS base

# gd + freetype: o dompdf usa a GD para rasterizar o logo da loja no cabeçalho
# do relatório financeiro. Sem ela a imagem é silenciosamente ignorada no PDF.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip libpq-dev libicu-dev libzip-dev libpng-dev libjpeg-dev libfreetype6-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql bcmath intl zip opcache gd \
    && pecl install redis && docker-php-ext-enable redis \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# ---------------------------------------------------------------------------
# Dependências primeiro: sem alteração em composer.json/lock, o Docker reaproveita
# esta camada e o build não baixa nada de novo.
# ---------------------------------------------------------------------------
FROM base AS vendor

COPY apps/api/composer.json apps/api/composer.lock ./

# --no-scripts: os scripts do Laravel precisam do código da aplicação, que ainda
# não foi copiado nesta camada. Rodam no estágio final.
RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --prefer-dist \
        --optimize-autoloader

# ---------------------------------------------------------------------------
# Imagem final
# ---------------------------------------------------------------------------
FROM base AS app

# OPcache: em produção o código não muda dentro do container, então revalidar
# timestamp a cada request é desperdício puro de I/O.
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/opcache.ini
COPY docker/php/php.ini /usr/local/etc/php/conf.d/zz-app.ini

COPY --from=vendor /app/vendor ./vendor
COPY apps/api ./

# Os diretórios de runtime do storage precisam existir na imagem. O .gitignore
# do Laravel exclui o conteúdo deles, e diretório vazio não entra no git — então
# o COPY acima não os traz. Nada dependia disso até o relatório financeiro, que
# compila um template Blade e falha com "Please provide a valid cache path"
# quando framework/views não existe. O job marca o relatório como failed e o
# dono da loja só vê "não foi possível gerar", sem pista da causa.
RUN mkdir -p storage/framework/views \
             storage/framework/cache/data \
             storage/framework/sessions \
             storage/logs \
             storage/app/private \
    && composer dump-autoload --no-dev --optimize --classmap-authoritative \
    && chown -R www-data:www-data storage bootstrap/cache

# storage/ e bootstrap/cache precisam ser graváveis pelo processo do PHP-FPM,
# que roda como www-data.
USER www-data

EXPOSE 9000

CMD ["php-fpm"]
