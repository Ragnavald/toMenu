# Origem absoluta da API. Vazia em desenvolvimento: o proxy do vite.config.ts
# resolve /api na mesma origem.
VITE_API_URL=

# Alerta de pedido novo (WebSocket).
#
# A chave é a mesma REVERB_APP_KEY do apps/api/.env — é pública por natureza, a
# autorização de cada canal acontece no backend.
#
# Toda VITE_* é inlined no bundle: mudar exige rebuild do painel.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
