<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!--
            Redis, não array. O store `array` guarda a referência PHP em
            memória e não exercita a serialização — foi exatamente isso que
            deixou passar o bug em que Collections aninhadas voltavam do cache
            como objeto e quebravam o JSON do storefront.
        -->
        <env name="CACHE_STORE" value="redis"/>
        <env name="REDIS_PREFIX" value="tomenu_test_"/>
        <!--
            Postgres real, não SQLite em memória. As policies de Row Level
            Security são a terceira camada de isolamento e só existem no
            Postgres — testá-las em SQLite daria uma suíte verde que não
            valida nada do que realmente protege os dados em produção.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="tomenu_test"/>
        <env name="DB_USERNAME" value="tomenu_app"/>
        <env name="DB_URL" value=""/>
        <env name="TENANCY_ROOT_DOMAIN" value="tomenu.test"/>
        <env name="TENANCY_TRUST_HEADER" value="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
