APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Cada loja é um subdomínio de TENANCY_ROOT_DOMAIN; domínio próprio não existe.
# Em produção o valor precisa casar com o wildcard `*.dominio` do Cloudflare —
# que cobre um nível só, então `loja.staging.dominio` ficaria sem certificado.
TENANCY_ROOT_DOMAIN=tomenu.test
TENANCY_STOREFRONT_SCHEME=http
TENANCY_STOREFRONT_PORT=3000

# X-Tenant é controlado pelo cliente: em produção, aceitá-lo deixaria qualquer
# visitante escolher a loja. Só existe para desenvolvimento sem wildcard DNS.
TENANCY_TRUST_HEADER=true

# Invalidação do cardápio nas camadas fora do Laravel (Next e Cloudflare).
#
# Sem isto o cardápio só atualiza quando o TTL expira, e o lojista edita um
# preço sem ver o resultado no site. Com as duas primeiras variáveis o tempo
# cai de minutos para segundos; as do Cloudflare completam, purgando a borda.
#
# REVALIDATE_SECRET precisa ser idêntico ao do storefront — é o que autentica
# a chamada. Gere com: openssl rand -hex 32
STOREFRONT_INTERNAL_URL=http://storefront:3000
REVALIDATE_SECRET=

# Token de API com permissão "Zone > Cache Purge" na zona da plataforma.
# Opcionais: sem eles a borda expira sozinha pelo TENANCY_CDN_TTL abaixo.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Janela em que a CDN pode servir o cardápio sem consultar a origem. Curta de
# propósito: é só a rede de proteção para o caso de um purge se perder.
TENANCY_CDN_TTL=30

# Consumidas pelo build do storefront no docker-compose.prod.yml. As
# NEXT_PUBLIC_* entram no bundle do browser em tempo de build, não em runtime:
# mudá-las exige rebuild da imagem, não só restart do container.
#
# NEXT_PUBLIC_API_URL é o endereço que o JAVASCRIPT NO NAVEGADOR usa, então
# precisa ser público (api.seudominio.com). O render no servidor não passa por
# ele — usa INTERNAL_API_URL, fixado como http://nginx:80 no compose.
NEXT_PUBLIC_API_URL=https://api.seudominio.com
NEXT_PUBLIC_ROOT_DOMAIN=seudominio.com
NEXT_PUBLIC_ADMIN_URL=https://app.seudominio.com

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# O alerta de pedido novo no painel depende disto. Com `log` o evento só é
# escrito no arquivo de log e a cozinha nunca é avisada.
BROADCAST_CONNECTION=reverb

# Servidor WebSocket.
#
# Três endereços diferentes, e confundi-los é a falha mais provável aqui:
#
#   REVERB_SERVER_HOST  o que o processo escuta (0.0.0.0 = todas as interfaces)
#   REVERB_HOST         para onde o backend CONECTA ao publicar o evento; em
#                       dev é o nome do serviço no compose. Apontar para
#                       0.0.0.0 quebra o broadcast com "cURL error 7"
#   VITE_REVERB_HOST    para onde o NAVEGADOR conecta — fica em apps/admin/.env
REVERB_APP_ID=tomenu
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail transacional (recuperação de senha).
#
# `log` em desenvolvimento: a mensagem vai para storage/logs/laravel.log em vez
# de ser entregue. É o que permite testar o fluxo inteiro sem credencial e sem
# mandar e-mail de teste para endereço real.
#
# Em produção usamos SMTP do Titan (contratado via HostGator) — ver DEPLOY.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# O remetente precisa ser do domínio verificado no provedor; um From de outro
# domínio é recusado pelo Titan ou marcado como spam pelo destinatário.
MAIL_FROM_ADDRESS="nao-responda@to-menu.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 — storage de imagens em produção (logo, capa e foto de produto).
# Preencher a chave já basta para o upload passar a usar o R2; sem ela, as
# imagens ficam no disco público do container e somem no deploy seguinte.
# CLOUDFLARE_R2_URL é o domínio público do bucket: sem ele, Storage::url() gera
# a URL do endpoint S3, que não é acessível publicamente e quebra as imagens no
# cardápio. O bucket precisa ter leitura pública.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_URL=https://cdn.seudominio.com

# Cloudflare Turnstile — verificação de robô no login e no cadastro de loja.
# Vazio desliga a verificação, que é o padrão em desenvolvimento e nos testes.
# Em produção é obrigatório: sem ele as duas rotas ficam abertas a automação.
# O secret fica só aqui; a sitekey (pública) vai no build dos frontends, em
# TURNSTILE_SITE_KEY no .env da raiz.
TURNSTILE_SECRET=

VITE_APP_NAME="${APP_NAME}"
